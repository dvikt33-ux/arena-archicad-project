{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/normative-ruleset.schema.json",
  "title": "Verified normative BIM ruleset",
  "type": "object",
  "required": ["verified_as_of", "rules"],
  "properties": {
    "verified_as_of": {"type": "string", "format": "date"},
    "purpose": {"type": "string"},
    "source": {"type": "string"},
    "source_title": {"type": "string"},
    "source_status": {"type": "string"},
    "status": {"type": "string"},
    "status_source": {"type": "string"},
    "text_source": {"type": "string"},
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": {"type": "string"},
          "title": {"type": "string"},
          "status": {"type": "string"},
          "status_source": {"type": "string"},
          "clauses": {"type": "array"},
          "fact": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/rule"}
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "state",
        "clause",
        "scope",
        "rule_kind",
        "automation",
        "rule",
        "must_not_assume"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "state": {
          "enum": ["active", "conditional", "manual_check", "future_effective", "replaced", "quarantine"]
        },
        "source": {"type": "string"},
        "source_title": {"type": "string"},
        "source_status": {"type": "string"},
        "clause": {"type": "string", "minLength": 1},
        "effective_from": {"type": ["string", "null"], "format": "date"},
        "scope": {"type": "string", "minLength": 1},
        "trigger": {"type": ["string", "null"]},
        "rule_kind": {
          "enum": ["coordination", "geometry", "product", "construction", "performance", "calculation", "documentation", "version_guard"]
        },
        "automation": {
          "enum": ["auto_apply", "auto_check", "suggest_only", "manual_check"]
        },
        "rule": {"type": ["string", "object", "array"]},
        "must_not_assume": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string"}
        },
        "depends_on": {"type": "array", "items": {"type": "string"}},
        "status_source": {"type": ["string", "null"]},
        "text_source": {"type": ["string", "null"]},
        "notes": {"type": ["string", "null"]}
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
